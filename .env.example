# PostgreSQL / TimescaleDB Configuration
POSTGRES_USER=layt
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=layt
DATABASE_URL=postgresql://layt:change-me-in-production@db:5432/layt

# MQTT Broker Authentication
